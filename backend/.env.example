# ==============================================================================
# ResuMind AI — Backend Environment Configuration
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# CORS Allowed Origins (comma-separated list of origins)
# Example: https://resumind-web.onrender.com,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# Active AI Provider: gemini | openai | claude | openrouter | grok | ml
AI_PROVIDER=gemini

# Request Timeout for AI Provider calls in milliseconds (default: 45000 = 45s)
AI_REQUEST_TIMEOUT_MS=45000

# ------------------------------------------------------------------------------
# 1. Google Gemini Settings (Recommended default)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. OpenAI Settings
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 3. Anthropic Claude Settings
# ------------------------------------------------------------------------------
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20240620

# ------------------------------------------------------------------------------
# 4. OpenRouter Settings
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# ------------------------------------------------------------------------------
# 5. xAI Grok Settings
# ------------------------------------------------------------------------------
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-4.5
